---
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  projects.sort((a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id));

  return projects.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      previous: index > 0 ? projects[index - 1] : undefined,
      next: projects.at(index + 1),
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry, previous, next } = Astro.props;
const { title, summary, kindLabel, year, stack, impact } = entry.data;
const { Content } = await render(entry);
---

<Base title={title} description={summary}>
  <div class="py-12 min-[721px]:py-16">
    <a href="/#work" class="inline-flex items-center gap-2 font-mono text-sm text-fg-dim hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
      <span aria-hidden="true">←</span> Back to work
    </a>

    <article class="mt-8">
      <header class="border-b border-line pb-8">
        <div class="flex flex-wrap items-center gap-3 font-mono text-xs">
          <span class="rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-accent">{kindLabel}</span>
          <time datetime={String(year)} class="text-fg-dim">{year}</time>
        </div>
        <h1 class="mt-4 text-balance text-3xl leading-tight font-semibold tracking-tight text-fg sm:text-5xl">{title}</h1>
        <p class="mt-3 max-w-prose text-lg leading-relaxed text-fg-dim">{summary}</p>

        <ul aria-label="Technologies" role="list" class="mt-5 flex flex-wrap gap-2 font-mono text-xs text-fg-dim">
          {stack.map((tool) => (
            <li class="rounded border border-line-strong px-2.5 py-1">{tool}</li>
          ))}
        </ul>

        {impact.length > 0 && (
          <dl aria-label="Project impact" class="mt-7 grid gap-3 sm:grid-cols-3">
            {impact.map(({ label, value }) => (
              <div class="rounded-lg border border-line bg-surface p-4">
                <dt class="font-mono text-xs text-accent">{label}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-fg">{value}</dd>
              </div>
            ))}
          </dl>
        )}
      </header>

      <div class="mt-8 max-w-prose leading-7 text-fg-dim [&_h2]:mb-2 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-fg [&_h2:not(:first-child)]:mt-7 [&_p+p]:mt-3">
        <Content />
      </div>
    </article>

    {(previous || next) && (
      <nav aria-label="Case studies" class="mt-10 grid gap-3 border-t border-line pt-6 sm:grid-cols-2">
        {previous && (
          <a href={`/work/${previous.id}/`} rel="prev" class="rounded-lg border border-line px-4 py-3 text-fg hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent">
            <span class="block font-mono text-xs text-fg-dim"><span aria-hidden="true">←</span> Previous project</span>
            <span class="mt-1 block text-sm">{previous.data.title}</span>
          </a>
        )}
        {next && (
          <a href={`/work/${next.id}/`} rel="next" class="rounded-lg border border-line px-4 py-3 text-fg hover:border-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent sm:col-start-2">
            <span class="block font-mono text-xs text-fg-dim">Next project <span aria-hidden="true">→</span></span>
            <span class="mt-1 block text-sm">{next.data.title}</span>
          </a>
        )}
      </nav>
    )}
  </div>
</Base>
