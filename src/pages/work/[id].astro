---
import { existsSync } from 'node:fs';
import type { InferGetStaticPropsType } from 'astro';
import { getCollection, render } from 'astro:content';
import Chip from '../../components/ui/Chip.astro';
import KindPill from '../../components/ui/KindPill.astro';
import CallLoggingFigure from '../../components/work/CallLoggingFigure.astro';
import ChurnModelFigure from '../../components/work/ChurnModelFigure.astro';
import DonationsPipelineFigure from '../../components/work/DonationsPipelineFigure.astro';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  projects.sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order || a.id.localeCompare(b.id));

  return projects.map((entry, index) => ({
    params: { id: entry.id },
    props: {
      entry,
      previous: index > 0 ? projects[index - 1] : undefined,
      next: projects.at(index + 1),
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { entry, previous, next } = Astro.props;
const { title, summary, kind, kindLabel, year, role, timeframe, stack, impact, impactVerified, figure, figureCaption } = entry.data;
const [leadImpact, ...supportingImpact] = impact;
const figures = new Map([
  ['call-logging', CallLoggingFigure],
  ['donations-pipeline', DonationsPipelineFigure],
  ['churn-model', ChurnModelFigure],
]);
const Figure = figure ? figures.get(figure) : undefined;
const hasResume = existsSync('public/resume.pdf');
const { Content } = await render(entry);
---

<Base title={title} description={summary}>
  <div class="py-12 min-[721px]:py-16">
    <a href="/#work" class="inline-flex min-h-11 items-center gap-2 font-mono text-sm text-fg-dim no-underline hover:text-accent">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" class="size-4" aria-hidden="true">
        <path d="M13 8H3m4-4L3 8l4 4" />
      </svg>
      Back to work
    </a>

    <article class="mt-8">
      <header>
        <h1 class="text-balance text-3xl leading-tight font-semibold tracking-tight text-fg sm:text-5xl">{title}</h1>
        <div class="mt-3 flex flex-wrap items-center gap-3 font-mono text-xs text-fg-dim tabular-nums">
          <KindPill kind={kind} label={kindLabel} />
          <time datetime={String(year)}>{year}</time>
        </div>
        <p class="mt-4 max-w-prose text-lg leading-relaxed text-pretty text-fg-dim">{summary}</p>

        {(role || timeframe) && (
          <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
            {role && (
              <div class="flex items-baseline gap-2">
                <dt class="font-mono text-xs text-fg-dim">Role</dt>
                <dd class="text-fg">{role}</dd>
              </div>
            )}
            {timeframe && (
              <div class="flex items-baseline gap-2">
                <dt class="font-mono text-xs text-fg-dim">Timeframe</dt>
                <dd class="text-fg">{timeframe}</dd>
              </div>
            )}
          </dl>
        )}

        <ul aria-label="Technologies" role="list" class="mt-4 flex flex-wrap gap-1.5">
          {stack.map((tool) => (
            <li><Chip>{tool}</Chip></li>
          ))}
        </ul>

        {leadImpact && (
          <section aria-label="Project impact" class="mt-8 border-t border-line pt-6">
            <dl>
              <div class="flex flex-col gap-2">
                <dt class="font-mono text-sm text-fg-dim">{leadImpact.label}</dt>
                <dd class="-order-1 flex flex-wrap items-baseline gap-x-3 gap-y-2">
                  <span class="min-w-0 font-mono text-[clamp(1.75rem,6vw,3rem)] leading-[1.1] tracking-tight text-balance text-fg tabular-nums">{leadImpact.value}</span>
                  {!impactVerified && (
                    <span class="inline-flex rounded-sm border border-yellow/25 bg-yellow/10 px-1.5 py-0.5 font-mono text-[0.6875rem] leading-none text-yellow">
                      <span aria-hidden="true">unverified</span>
                      <span class="sr-only">unverified figure</span>
                    </span>
                  )}
                </dd>
              </div>
            </dl>

            {supportingImpact.length > 0 && (
              <dl class="mt-5 grid grid-cols-[repeat(auto-fit,minmax(min(100%,8rem),1fr))] border-t border-l border-line">
                {supportingImpact.map(({ label, value }, index) => (
                  <div class="min-w-0 border-r border-b border-line">
                    <dt>
                      <span aria-hidden="true" class="block border-b border-line bg-surface px-3 py-1 font-mono text-xs text-comment">{String.fromCharCode(65 + index)}</span>
                      <span class="block px-3 pt-2 text-sm text-fg-dim">{label}</span>
                    </dt>
                    <dd class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-1.5 px-3 pb-3 font-mono text-xs/5 text-fg tabular-nums">
                      <span class="min-w-0 text-pretty">{value}</span>
                      {!impactVerified && (
                        <span class="inline-flex rounded-sm border border-yellow/25 bg-yellow/10 px-1.5 py-0.5 font-mono text-[0.6875rem] leading-none text-yellow">
                          <span aria-hidden="true">unverified</span>
                          <span class="sr-only">unverified figure</span>
                        </span>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
          </section>
        )}
      </header>

      {Figure && (
        <figure class="mt-8 border border-line bg-surface">
          <Figure />
          <figcaption class="border-t border-line px-4 py-2 font-mono text-xs text-fg-dim">
            {figureCaption}
          </figcaption>
        </figure>
      )}

      <div class="case-body mt-8 leading-7 text-fg-dim">
        <Content />
      </div>

      <footer class="mt-10 space-y-6 border-t border-line pt-6">
        {(previous || next) && (
          <nav aria-label="Case studies" class:list={['grid gap-px border border-line bg-line', previous && next && 'sm:grid-cols-2']}>
            {previous && (
              <a href={`/work/${previous.id}/`} rel="prev" class="group block bg-bg px-4 py-3 text-fg no-underline hover:bg-surface focus-visible:bg-surface">
                <span class="inline-flex items-center gap-1.5 font-mono text-xs text-fg-dim">
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
                    <path d="M13 8H3m4-4L3 8l4 4" />
                  </svg>
                  Previous project
                </span>
                <span class="mt-1 block text-sm text-balance group-hover:text-accent group-focus-visible:text-accent">{previous.data.title}</span>
              </a>
            )}
            {next && (
              <a href={`/work/${next.id}/`} rel="next" class="group block bg-bg px-4 py-3 text-fg no-underline hover:bg-surface focus-visible:bg-surface">
                <span class="inline-flex items-center gap-1.5 font-mono text-xs text-fg-dim">
                  Next project
                  <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" class="size-3.5" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </span>
                <span class="mt-1 block text-sm text-balance group-hover:text-accent group-focus-visible:text-accent">{next.data.title}</span>
              </a>
            )}
          </nav>
        )}

        {/* TODO(copy): Review the closing CTA wording. */}
        <section aria-labelledby="case-contact" class="border border-line bg-surface p-5 sm:flex sm:items-center sm:justify-between sm:gap-4">
          <h2 id="case-contact" class="text-xl font-semibold tracking-tight text-balance text-fg">Like this kind of work?</h2>
          <div class="mt-4 flex flex-wrap gap-2 sm:mt-0">
            <a href="/#contact" class="btn">Get in touch</a>
            {hasResume && <a href="/resume.pdf" class="btn-ghost">Résumé</a>}
          </div>
        </section>
      </footer>
    </article>
  </div>
</Base>

<style>
  /* Rendered Markdown: prose stays at reading width; screenshots and code may use the full column. */
  .case-body :global(:is(p, ul, ol, h2, h3, small)) {
    max-width: 65ch;
  }
  .case-body :global(h2) {
    margin-bottom: 0.5rem;
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-fg);
  }
  .case-body :global(h2:not(:first-child)) {
    margin-top: 2.5rem;
  }
  .case-body :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.25rem;
    font-weight: 600;
    color: var(--color-fg);
  }
  .case-body :global(p) {
    text-wrap: pretty;
  }
  .case-body :global(:is(p, ul, ol, pre, img) + :is(p, ul, ol, pre, img)) {
    margin-top: 1rem;
  }
  .case-body :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .case-body :global(li + li) {
    margin-top: 0.375rem;
  }
  .case-body :global(li::marker) {
    color: var(--color-comment);
  }
  .case-body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin-block: 1.25rem;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
  }
  .case-body :global(pre) {
    margin-block: 1rem;
    overflow-x: auto;
    border: 1px solid var(--color-line);
    border-radius: 0.25rem;
    padding: 0.875rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
  }
  .case-body :global(:not(pre) > code) {
    border-radius: 0.25rem;
    background: var(--color-surface);
    padding: 0.1em 0.35em;
    font-family: var(--font-mono);
    font-size: 0.875em;
    color: var(--color-fg);
  }
  .case-body :global(small) {
    display: block;
    margin-top: 2rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-comment);
  }
</style>
