---
import Section from './Section.astro';

const index = 'border border-line bg-bg px-1 text-center font-mono text-xs font-normal tabular-nums text-comment';
const label = 'border border-line bg-surface px-2.5 py-3 text-left align-top font-mono text-xs/6 font-medium text-accent sm:px-4';
const detail = 'border border-line px-3 py-3 align-top sm:px-4';
const note = 'mt-1.5 block font-mono text-xs text-fg-dim';
---

<Section id="now" title="currently">
  <!-- TODO(copy): Add an updated value with the date this section was actually reviewed. -->
  <table class="w-full table-fixed border-collapse text-sm/6">
    <colgroup>
      <col class="w-7" />
      <col class="w-[28%] sm:w-36" />
      <col />
    </colgroup>
    <thead aria-hidden="true">
      <tr class="h-7">
        <td class={index}></td>
        <td class={index}>A</td>
        <td class={index}>B</td>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td class={index} aria-hidden="true">1</td>
        <th class={label} scope="row">working on</th>
        <td class={detail}>Refining the churn model — adding channel features and a recency decay.</td>
      </tr>
      <tr>
        <td class={index} aria-hidden="true">2</td>
        <th class={label} scope="row">reading</th>
        <td class={detail}>
          Tufte, again. <cite>Visual Display of Quantitative Information</cite>.
          <span class={note}>slow re-read · year 2</span>
        </td>
      </tr>
      <tr>
        <td class={index} aria-hidden="true">3</td>
        <th class={label} scope="row">learning</th>
        <td class={detail}>
          Polars. Pandas works fine; Polars feels nicer.
          <span class={note}>10% in · enjoying it</span>
        </td>
      </tr>
      <tr>
        <td class={index} aria-hidden="true">4</td>
        <th class={label} scope="row">listening</th>
        <td class={detail}>Long-form ambient and one country album on repeat.</td>
      </tr>
    </tbody>
  </table>
</Section>
