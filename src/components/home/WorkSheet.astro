---
import { getCollection } from 'astro:content';
import { ArrowRight } from 'lucide-react';
import Chip from '../ui/Chip.astro';
import KindPill from '../ui/KindPill.astro';
import Section from './Section.astro';

const projects = await getCollection('projects', (project) => !project.data.draft);
projects.sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order || a.id.localeCompare(b.id));

const headers = [['A', 'Year'], ['B', 'Project'], ['C', 'Impact']];
const columns = 'sm:grid-cols-[2rem_4rem_minmax(0,1fr)_9rem]';
const kindColors = { excel: '--color-green', code: '--color-blue', writing: '--color-cyan' };
const measured = projects.reduce((count, { data }) => count + Number(data.impact.length > 0), 0);
const cell = 'min-w-0 border-line px-3 sm:px-2';
const cellLabel = 'shrink-0 font-mono text-xs text-fg-dim sm:sr-only';
---

<Section id="work" title="work">
  <p class="mb-4 text-base/7 text-fg-dim">Selected projects</p>
  {projects.length ? (
    <div class="relative border border-line">
      <div aria-hidden="true" class="hidden items-center border-b border-line bg-bg-deep font-mono text-xs sm:flex">
        <span id="sheet-cell-ref" class="w-16 shrink-0 border-r border-line py-1.5 text-center text-accent">B:B</span>
        <span class="px-2 text-comment italic">fx</span>
        <span id="sheet-formula" class="min-w-0 truncate pr-2 text-fg-dim">=COUNTA(B:B)</span>
      </div>
      <div class:list={['hidden border-b border-line bg-surface font-mono text-xs sm:grid', columns]} aria-hidden="true">
        <span class="self-end pb-1.5 text-center text-comment tabular-nums">1</span>
        {headers.map(([letter, label]) => (
          <div class="border-l border-line last:text-right">
            <span class="block border-b border-line py-1 text-center text-comment">{letter}</span>
            <span class="block px-2 py-1.5 font-medium text-fg-dim">{label}</span>
          </div>
        ))}
      </div>
      <ol id="sheet-rows" role="list" class="divide-y divide-line">
        {projects.map(({ id, data }, index) => {
          const [impact] = data.impact;
          return (
            <li style={`--fill-delay: ${Math.min(index, 4) * 60}ms`}>
              <a
                href={`/work/${id}/`}
                data-sheet-cell={`B${index + 2}`}
                style={`--kind-color: var(${kindColors[data.kind]})`}
                aria-labelledby={`work-${id}-title`}
                aria-describedby={`work-${id}-summary`}
                class:list={[
                  'sheet-row group relative grid grid-cols-[2rem_minmax(0,1fr)] text-fg no-underline hover:bg-surface focus-visible:bg-surface',
                  columns,
                ]}
              >
                <span aria-hidden="true" class="sheet-gutter relative row-span-3 border-r border-line bg-surface pt-2.5 text-center font-mono text-xs text-comment tabular-nums sm:row-span-1 sm:pt-3.5">{index + 2}</span>
                <div class:list={[cell, 'flex items-baseline gap-2 border-b py-2 font-mono text-xs tabular-nums sm:border-r sm:border-b-0 sm:py-3.5']}>
                  <span class={cellLabel}>Year:</span>
                  <time datetime={String(data.year)}>{data.year}</time>
                </div>
                <div class:list={[cell, 'sheet-project border-b py-3 sm:border-r sm:border-b-0']}>
                  <div class="flex items-baseline justify-between gap-2">
                    <h3 id={`work-${id}-title`} transition:name={`title-${id}`} class="wrap-anywhere text-base/6 font-semibold text-fg group-hover:text-accent group-focus-visible:text-accent">{data.title}</h3>
                    <ArrowRight size={14} aria-hidden="true" className="shrink-0 self-center text-fg-dim group-hover:text-accent group-focus-visible:text-accent" />
                  </div>
                  <KindPill kind={data.kind} label={data.kindLabel} class="mt-1 max-w-full whitespace-normal! wrap-anywhere" transition:name={`pill-${id}`} />
                  <p id={`work-${id}-summary`} class="mt-1 wrap-anywhere text-sm/6 text-pretty text-fg-dim">{data.summary}</p>
                  {data.stack.length > 0 && (
                    <ul role="list" aria-label="Stack" class="mt-2 hidden flex-wrap gap-1 sm:flex">
                      {data.stack.map((tag) => <li class="min-w-0"><Chip class="wrap-anywhere">{tag}</Chip></li>)}
                    </ul>
                  )}
                </div>
                <div class:list={[cell, 'flex items-baseline justify-between gap-2 py-2 text-right tabular-nums sm:block sm:py-3']}>
                  <span class={cellLabel}>Impact:</span>
                  {impact ? (
                    <div class="min-w-0 wrap-anywhere">
                      <p class="font-mono text-sm/5 font-medium text-fg">{impact.value}</p>
                      <p class="text-xs/5 text-comment">{impact.label}</p>
                      {!data.impactVerified && (
                        <span class="mt-1 inline-flex rounded-sm border border-yellow/25 bg-yellow/10 px-1.5 py-0.5 font-mono text-xs/4 text-yellow">
                          <span aria-hidden="true">unverified</span>
                          <span class="sr-only">unverified figure</span>
                        </span>
                      )}
                    </div>
                  ) : (
                    <span class="text-sm/5 text-comment">
                      <span aria-hidden="true">—</span><span class="sr-only">No impact figure</span>
                    </span>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ol>
      <div aria-hidden="true" class:list={['pointer-events-none absolute inset-0 z-10 hidden sm:grid', columns]}>
        <span id="sheet-selection" class="sheet-selection relative col-start-3 self-start border-2 border-accent" hidden></span>
      </div>
      <p class="border-t border-line bg-surface px-2 py-1.5 font-mono text-xs text-comment tabular-nums">
        Ready · {projects.length} {projects.length === 1 ? 'row' : 'rows'} · {measured} measured
      </p>
    </div>
  ) : <p class="border border-line px-3 py-4 text-sm text-fg-dim">No projects to show.</p>}
</Section>

<style>
  .sheet-gutter::before,
  .sheet-selection::after {
    content: '';
    position: absolute;
  }

  .sheet-gutter::before {
    inset: 0 auto 0 0;
    width: 6px;
    background: var(--kind-color);
    transform: scaleX(0.5);
    transform-origin: left;
  }

  .sheet-row:focus-visible {
    outline: none;
  }

  .sheet-row:focus-visible .sheet-project {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .sheet-row:focus-visible .sheet-gutter::before {
    transform: scaleX(1);
  }

  @media (hover: hover) {
    .sheet-row:hover .sheet-gutter::before {
      transform: scaleX(1);
    }
  }

  .sheet-selection::after {
    right: 0;
    bottom: 0;
    width: 5px;
    height: 5px;
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .sheet-gutter::before {
      transition: transform 100ms ease-out;
    }

    .sheet-selection {
      transition: transform 120ms cubic-bezier(0.25, 1, 0.5, 1);
    }

    .is-filling > li {
      animation: fill-down 180ms cubic-bezier(0.16, 1, 0.3, 1) var(--fill-delay) backwards;
    }
  }

  @keyframes fill-down {
    from { clip-path: inset(0 0 100%); }
    to { clip-path: inset(0); }
  }
</style>

<script>
  let hasFilled = false;

  document.addEventListener('astro:page-load', () => {
    const rows = document.getElementById('sheet-rows');
    const ref = document.getElementById('sheet-cell-ref');
    const formula = document.getElementById('sheet-formula');
    const selection = document.getElementById('sheet-selection');
    if (!rows || !ref || !formula || !selection) return;

    const idleRef = ref.textContent;
    const idleFormula = formula.textContent;
    let active: HTMLAnchorElement | null = null;

    const rowFor = (target: EventTarget | null) =>
      target instanceof Element ? target.closest<HTMLAnchorElement>('[data-sheet-cell]') : null;

    const placeSelection = () => {
      if (!active) return;
      selection.style.height = `${active.offsetHeight}px`;
      selection.style.transform = `translateY(${active.offsetTop}px)`;
    };

    const select = (row: HTMLAnchorElement | null) => {
      if (row === active) return;
      active = row;
      ref.textContent = row?.dataset.sheetCell ?? idleRef;
      formula.textContent = row ? `=HYPERLINK("${row.getAttribute('href')}")` : idleFormula;
      placeSelection();
      selection.hidden = !row;
    };

    rows.addEventListener('pointerover', ({ target, pointerType }) => {
      if (pointerType === 'touch') return;
      const row = rowFor(target);
      if (row) select(row);
    });
    rows.addEventListener('pointerleave', () => select(rowFor(document.activeElement)));
    rows.addEventListener('focusin', ({ target }) => {
      rows.classList.remove('is-filling');
      select(rowFor(target));
    });
    rows.addEventListener('focusout', ({ relatedTarget }) => {
      select(rowFor(relatedTarget) ?? rows.querySelector<HTMLAnchorElement>('[data-sheet-cell]:hover'));
    });

    const resize = new ResizeObserver(placeSelection);
    resize.observe(rows);

    let reveal: IntersectionObserver | undefined;
    if (!hasFilled && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      reveal = new IntersectionObserver(([entry], observer) => {
        if (!entry?.isIntersecting) return;
        observer.disconnect();
        hasFilled = true;
        if (rows.matches(':focus-within')) return;
        rows.classList.add('is-filling');
        setTimeout(() => rows.classList.remove('is-filling'), 450);
      });
      reveal.observe(rows);
    }

    document.addEventListener('astro:before-swap', () => {
      resize.disconnect();
      reveal?.disconnect();
    }, { once: true });
  });
</script>
