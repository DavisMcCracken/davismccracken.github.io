---
interface Props {
  availability: string;
  resumeHref?: string;
}

const { availability, resumeHref } = Astro.props;
---

<section id="top" aria-labelledby="hero-heading" class="pt-9 sm:pt-14">
  <p class="font-mono text-xs text-accent">~/davis-mccracken</p>
  <h1 id="hero-heading" class="mt-3 font-serif text-[clamp(2.75rem,7vw,4rem)] leading-none tracking-tight text-balance">
    Davis McCracken
  </h1>
  <p class="mt-3 text-base/6 font-medium sm:text-lg/7">Database Coordinator, Ronald McDonald House Louisville</p>
  <p class="mt-1 max-w-[65ch] text-base/6 text-pretty text-fg-dim">{availability}</p>

  <h2 class="mt-6 text-xl/7 font-semibold tracking-tight text-balance sm:text-2xl/8">
    <span class="text-accent">Spreadsheets</span>, scripts, and the occasional regression.
  </h2>
  <p class="mt-2 max-w-[65ch] text-base/7 text-pretty text-fg-dim">
    I work where the donor database meets the spreadsheet meets the script — building pipelines,
    automating reporting, and turning manual processes into something a Monday morning can survive.
  </p>
  <div class="mt-5 flex flex-wrap gap-2">
    <a class="btn" href="#work">View work</a>
    {resumeHref && <a class="btn-ghost" href={resumeHref}>Résumé</a>}
  </div>
</section>
