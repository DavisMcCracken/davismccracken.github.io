---
import BootSequence from './BootSequence';
---

<section id="top" aria-labelledby="hero-heading" class="scroll-mt-24 pt-14 sm:pt-22">
  <p class="flex flex-wrap items-center gap-x-2.5 font-mono text-xs text-fg-dim">
    <span class="text-accent">~/davis-mccracken</span>
    <span aria-hidden="true">·</span>
    <span>portfolio</span>
    <span aria-hidden="true" class="h-3 w-1.5 rounded-xs bg-accent/70"></span>
  </p>

  <BootSequence client:media="(prefers-reduced-motion: no-preference)" />

  <h1 id="hero-heading" class="text-[clamp(2.0625rem,6vw,3.75rem)] leading-[1.08] font-semibold tracking-[-0.04em] text-balance">
    Spreadsheets, scripts, and the <span class="text-accent">occasional</span> regression.
  </h1>
  <p class="mt-5 max-w-[56ch] text-base/7 text-pretty text-fg-dim sm:text-lg/8">
    I work where the donor database meets the spreadsheet meets the script — building pipelines,
    automating reporting, and turning manual processes into something a Monday morning can survive.
  </p>
  <p class="mt-6 inline-flex items-center gap-2.5 rounded-full border border-line bg-surface px-3.5 py-2 font-mono text-xs leading-relaxed text-fg-dim">
    <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-green"></span>
    database coordinator · ronald mcdonald house louisville
  </p>
</section>
