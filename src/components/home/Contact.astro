---
import Section from './Section.astro';

interface Props {
  resumeHref?: string;
}

const { resumeHref } = Astro.props;
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY?.trim();
const email = 'davisnmccracken@gmail.com';
const label = 'grid gap-1.5 font-mono text-xs text-fg-dim';
const field = 'min-h-11 w-full rounded-lg border border-line-strong bg-bg px-3 py-2.5 font-sans text-base text-fg placeholder:text-fg-dim';
const profileLink = 'inline-flex min-h-11 items-center font-mono text-sm text-fg-dim underline decoration-line-strong underline-offset-4 hover:text-accent hover:decoration-accent';
---

<Section id="contact" title="contact">
  <div class="rounded-xl border border-line bg-surface p-5 sm:p-7">
    <h3 class="text-xl font-semibold tracking-tight text-balance sm:text-2xl">Got a problem worth <span class="text-accent">solving</span>?</h3>
    <p class="mt-1 text-sm/6 text-fg-dim">Or just want to say hi. Either works.</p>

    <p id="contact-email" class="mt-5 font-mono text-sm wrap-anywhere text-fg-dim">{email}</p>
    <div class="mt-2 flex flex-wrap items-center gap-2">
      <a class="btn" href={`mailto:${email}`}>Email me</a>
      <button id="copy-email" class="btn-ghost cursor-pointer" type="button" hidden>Copy email</button>
      <span id="copy-email-status" class="text-sm/6 text-fg-dim" aria-live="polite" aria-atomic="true"></span>
    </div>
    <ul role="list" class="mt-2 flex flex-wrap gap-x-5">
      <li><a class={profileLink} href="https://github.com/DavisMcCracken" target="_blank" rel="noreferrer">GitHub<span class="sr-only"> (opens in a new tab)</span></a></li>
      <li><a class={profileLink} href="https://www.linkedin.com/in/davis-mccracken/" target="_blank" rel="noreferrer">LinkedIn<span class="sr-only"> (opens in a new tab)</span></a></li>
      {resumeHref && <li><a class={profileLink} href={resumeHref}>Résumé (PDF)</a></li>}
    </ul>

    {accessKey && (
      <form action="https://api.web3forms.com/submit" method="post" class="mt-4 grid gap-4 border-t border-line pt-5">
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="redirect" value={new URL('thanks/', Astro.site ?? Astro.url).href} />
        <div class="grid gap-4 sm:grid-cols-2">
          <label class={label}>
            name
            <input class={field} type="text" name="name" autocomplete="name" placeholder="Your name" required />
          </label>
          <label class={label}>
            email
            <input class={field} type="email" name="email" autocomplete="email" placeholder="you@somewhere.com" required />
          </label>
        </div>
        <label class={label}>
          <span>subject <span class="text-fg-dim/85">· optional</span></span>
          <input class={field} type="text" name="subject" placeholder="Excel rescue mission, regression help, just saying hi…" />
        </label>
        <label class={label}>
          message
          <textarea class:list={[field, 'resize-y']} name="message" rows="4" placeholder="A few sentences is plenty" required></textarea>
        </label>
        <button type="submit" class="btn-ghost w-fit cursor-pointer">Send message</button>
      </form>
    )}
  </div>
</Section>

<script>
  document.addEventListener('astro:page-load', () => {
    const button = document.getElementById('copy-email');
    const address = document.getElementById('contact-email')?.textContent?.trim();
    const status = document.getElementById('copy-email-status');
    if (!button || !address || !status || !navigator.clipboard?.writeText) return;

    button.addEventListener('click', async () => {
      status.textContent = '';
      try {
        await navigator.clipboard.writeText(address);
        status.textContent = 'Copied.';
      } catch {
        status.textContent = 'Couldn’t copy. Select the address to copy it manually.';
      }
    });
    button.hidden = false;
  });
</script>
