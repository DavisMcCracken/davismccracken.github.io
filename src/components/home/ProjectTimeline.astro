---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const projects = await getCollection('projects', (project) => !project.data.draft);
projects.sort((a, b) => b.data.year - a.data.year || a.data.order - b.data.order || a.id.localeCompare(b.id));

const byYear = new Map<number, typeof projects>();
for (const project of projects) {
  const group = byYear.get(project.data.year);
  if (group) group.push(project);
  else byYear.set(project.data.year, [project]);
}

const stylesByKind = {
  excel: { marker: 'bg-green', pill: 'border-green/25 bg-green/10 text-green' },
  code: { marker: 'bg-blue', pill: 'border-blue/25 bg-blue/10 text-blue' },
  algo: { marker: 'bg-orange', pill: 'border-orange/25 bg-orange/10 text-orange' },
};
---

<Section id="work" title="work" meta={`${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`}>
  <p class="mb-5 text-base/7 text-fg-dim">Things I've built at work and on weekends.</p>
  <div class="divide-y divide-line">
    {Array.from(byYear, ([year, entries]) => (
      <div class="grid gap-3 py-5 first:pt-0 last:pb-0 sm:grid-cols-[3.75rem_minmax(0,1fr)] sm:items-start sm:gap-5">
        <h3 class="font-mono text-sm tracking-wide text-accent tabular-nums sm:sticky sm:top-24 sm:pt-3">
          <time datetime={String(year)}>{year}</time>
        </h3>
        <ul role="list" class="ml-1.5 space-y-1 border-l border-line-strong pl-5">
          {entries.map(({ id, data }) => (
            <li class="relative">
              <span
                aria-hidden="true"
                class:list={['pointer-events-none absolute top-5 -left-5 size-2.5 -translate-x-1/2 rounded-full border-2 border-bg ring-1 ring-line-strong', stylesByKind[data.kind].marker]}
              ></span>
              <a
                href={`/work/${id}/`}
                aria-labelledby={`work-${id}-title`}
                class="group relative -mx-2 block rounded-lg px-2 py-3 motion-safe:transition-colors hover:bg-surface focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
              >
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 pr-6">
                  <h4 id={`work-${id}-title`} class="text-base font-semibold group-hover:text-accent group-focus-visible:text-accent">{data.title}</h4>
                  <span class:list={['rounded-full border px-2 py-0.5 font-mono text-[0.6875rem]', stylesByKind[data.kind].pill]}>
                    {data.kindLabel}
                  </span>
                </div>
                <span aria-hidden="true" class="absolute top-3 right-2 font-mono text-sm text-fg-dim/85 group-hover:text-accent group-focus-visible:text-accent">→</span>
                <p class="mt-1.5 max-w-[62ch] text-sm/6 text-pretty text-fg-dim">{data.summary}</p>
                <ul role="list" class="mt-2.5 flex flex-wrap gap-1.5">
                  {data.stack.map((tag) => (
                    <li class="rounded-md border border-line bg-surface px-2 py-0.5 font-mono text-[0.6875rem] text-fg-dim">{tag}</li>
                  ))}
                </ul>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</Section>
