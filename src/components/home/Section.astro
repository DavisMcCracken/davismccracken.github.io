---
const refs = { work: 'A1', about: 'B1', contact: 'C1' };

interface Props {
  id: keyof typeof refs;
  title: string;
}

const { id, title } = Astro.props;
const heading = `${id}-heading`;
---

<section id={id} aria-labelledby={heading}>
  <header class="mb-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line pb-2.5">
    <h2 id={heading} class="text-lg font-semibold tracking-tight">
      <span aria-hidden="true" class="mr-3 font-mono text-xs font-medium text-comment">{refs[id]}</span>{title}
    </h2>
  </header>
  <slot />
</section>
