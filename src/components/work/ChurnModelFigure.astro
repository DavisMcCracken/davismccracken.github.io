---
const curve = 'M56 198C90 129 135 99 192 77S337 50 446 48';
---

<svg
  viewBox="0 0 480 266"
  width="480"
  height="266"
  role="img"
  aria-label="Synthetic cumulative gains chart by score decile. The model curve rises above the diagonal baseline and meets it again in the final decile."
  class="block h-auto w-full font-mono"
>
  <g fill="currentColor" font-size="19" class="text-fg-dim">
    <text x="56" y="28">Cumulative gains</text>
    <text x="251" y="249" text-anchor="middle">Score decile</text>
  </g>

  <path d="M56 48h390M56 85.5h390M56 123h390M56 160.5h390" fill="none" stroke="currentColor" class="text-line-strong" />
  <path d={`${curve}Z`} fill="currentColor" class="text-orange/10" />
  <path d="M56 198 446 48" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="6 5" class="text-fg-dim" />
  <path d={curve} fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" class="text-orange" />
  <path d="M56 48v150h390" fill="none" stroke="currentColor" class="text-fg-dim/70" />

  {Array.from({ length: 10 }, (_, index) => {
    const x = 56 + 39 * (index + 1);

    return (
      <g class="text-fg-dim">
        <path d={`M${x} 198v6`} stroke="currentColor" />
        <text x={x} y="223" fill="currentColor" font-size="17" text-anchor="middle">{index + 1}</text>
      </g>
    );
  })}

  <text x="190" y="103" fill="currentColor" font-size="19" class="text-orange">Model</text>
  <text x="283" y="137" fill="currentColor" font-size="19" class="text-fg-dim">Baseline</text>
</svg>
